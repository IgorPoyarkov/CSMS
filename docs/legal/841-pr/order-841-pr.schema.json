    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "digitizedAt",
        "source",
        "scope",
        "documents",
        "clauses",
        "appendices",
        "formulas",
        "relations",
        "summary"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "digitizedAt": {
            "type": "string",
            "format": "date"
        },
        "language": {
            "type": "string"
        },
        "subject": {
            "type": "string"
        },
        "source": {
            "$ref": "#/$defs/source"
        },
        "machineReadable": {
            "$ref": "#/$defs/machineReadable"
        },
        "scope": {
            "$ref": "#/$defs/scope"
        },
        "definitions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/definition"
            }
        },
        "documents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/document"
            },
            "minItems": 1
        },
        "clauses": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/clause"
            }
        },
        "appendices": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/appendix"
            },
            "minItems": 1
        },
        "formulas": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/formula"
            }
        },
        "relations": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/relation"
            }
        },
        "consistencyNotes": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/consistencyNote"
            }
        },
        "externalReferences": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/externalReference"
            }
        },
        "summary": {
            "$ref": "#/$defs/summary"
        }
    },
    "$defs": {
