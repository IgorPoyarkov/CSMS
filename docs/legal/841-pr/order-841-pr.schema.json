            "properties": {
                "where": {
                    "type": "string"
                },
                "publishInEis": {
                    "type": "boolean"
                },
                "attachmentsRequired": {
                    "type": "boolean"
                }
            }
        },
        "field": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "label",
                "dataType",
                "required"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                },
                "label": {
                    "type": "string"
                },
                "dataType": {
                    "type": "string",
