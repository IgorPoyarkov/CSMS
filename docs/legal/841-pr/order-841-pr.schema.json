            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "issuer",
                "number",
                "date",
                "title",
                "registration",
                "edition"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "const": "normative_act"
                },
                "issuer": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                },
                "date": {
                    "type": "string",
                    "format": "date"
                },
                "title": {
                    "type": "string"
                },
                "registration": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "authority",
                        "date",
                        "number"
                    ],
                    "properties": {
                        "authority": {
                            "type": "string"
                        },
                        "date": {
                            "type": "string",
                            "format": "date"
                        },
                        "number": {
                            "type": "string"
                        }
                    }
                },
                "edition": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "revisionDate",
                        "isCurrent",
                        "amendingActs"
