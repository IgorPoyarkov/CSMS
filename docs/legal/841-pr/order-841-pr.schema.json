                        "$ref": "#/$defs/tableRow"
                    }
                },
                "totalRows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/tableRow"
                    }
                },
                "invariants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/invariant"
                    }
                }
            }
