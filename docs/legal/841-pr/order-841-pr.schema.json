                            },
                            "title": {
                                "type": "string"
                            },
                            "clauses": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "clause": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "document",
                "ref",
                "title",
                "summary",
                "appendixRefs"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^(order|poryadok|metodika)-p[0-9-]+$"
                },
                "document": {
                    "type": "string",
                    "enum": [
                        "order",
                        "poryadok",
                        "metodika"
                    ]
                },
                "ref": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
