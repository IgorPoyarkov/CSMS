                "appendixRefs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "formulaRefs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "appendix": {
