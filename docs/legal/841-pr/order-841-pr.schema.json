                "label",
                "title",
                "kind",
                "status",
                "recommendedTemplate",
                "purpose",
                "legalBasis",
                "applicability",
                "placement",
                "headerFields",
                "tables",
                "totals",
                "signatures",
                "fillRules",
                "notes",
                "relatedAppendices",
                "formulaRefs"
