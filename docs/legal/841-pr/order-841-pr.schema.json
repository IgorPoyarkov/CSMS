            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "order",
                        "appendix_to_order"
                    ]
                },
                "number": {
                    "type": [
                        "string",
                        "integer"
                    ]
                },
                "date": {
                    "type": "string",
                    "format": "date"
                },
                "title": {
                    "type": "string"
                },
                "parent": {
                    "type": "string"
                },
                "appendixRefs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sections": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "number",
                            "title",
                            "clauses"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "number": {
                                "type": [
                                    "string",
                                    "null"
