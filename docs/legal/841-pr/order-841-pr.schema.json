                "signatures": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "customer",
                            "contractor",
                            "composed_by",
                            "checked_by"
                        ]
                    }
                },
                "footerFields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field"
                    }
                },
                "fillRules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/fillRule"
                    }
                },
                "notes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "relatedAppendices": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "formulaRefs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "where",
                "publishInEis"
