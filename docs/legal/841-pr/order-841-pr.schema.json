                                    "number",
                                    "date"
                                ],
                                "properties": {
                                    "number": {
                                        "type": "string"
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                }
                            }
                        }
                    }
                },
                "legalBasis": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "ref",
                            "role"
                        ],
                        "properties": {
                            "ref": {
                                "type": "string"
                            },
                            "role": {
                                "type": "string"
                            }
                        }
                    }
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name",
                            "url",
                            "usedFor"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "url": {
                                "type": "string",
                                "format": "uri"
                            },
                            "usedFor": {
                                "type": "string"
                            }
                        }
                    }
                },
                "disclaimer": {
                    "type": "string"
                }
            }
        },
        "machineReadable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "format",
                "schema",
                "validator",
                "command"
            ],
            "properties": {
                "format": {
                    "type": "string",
                    "const": "json"
                },
                "schema": {
                    "type": "string"
                },
                "validator": {
                    "type": "string"
                },
                "command": {
                    "type": "string"
                }
            }
        },
        "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "appliesTo",
                "notAppliesTo",
                "optionalApplication",
                "pricingBasis"
            ],
            "properties": {
                "appliesTo": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "notAppliesTo": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "optionalApplication": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "pricingBasis": {
                    "type": "string"
                }
            }
        },
        "definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "term",
                "definition"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^def-[a-z0-9-]+$"
                },
                "term": {
                    "type": "string"
                },
                "definition": {
                    "type": "string"
                }
            }
        },
        "document": {
