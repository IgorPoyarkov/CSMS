{
  "name": "csms",
  "private": true,
  "version": "0.0.0",
  "description": "Система управления контрактной службой заказчика",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "npm run test:scripts && npm run check:pp2604 && npm run check:pp2571 && npm run check:eis17-criteria && npm run check:notice-okpd2 && npm run check:eis-packages && npm run check:eis-execution && npm run check:841 && npm run check:contract-deadlines && npm run check:smp && npm run check:estimates",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "check:db": "node scripts/check-db-schema.mjs",
    "check:mobile": "node scripts/mobile-audit.mjs",
    "check:pp2604": "node scripts/run-ts-check.mjs scripts/check-pp2604-rules.ts",
    "check:pp2571": "node scripts/run-ts-check.mjs scripts/check-pp2571.ts",
    "check:eis17-criteria": "node scripts/run-ts-check.mjs scripts/check-eis17-criteria.ts",
    "check:notice-okpd2": "node scripts/run-ts-check.mjs scripts/check-notice-multi-okpd2.ts",
    "check:eis-packages": "node scripts/run-ts-check.mjs scripts/check-eis-packages.ts",
    "check:eis-execution": "node scripts/run-ts-check.mjs scripts/check-eis-execution-readiness.ts",
    "check:841": "node scripts/check-order-841.mjs",
    "check:contract-deadlines": "node scripts/run-ts-check.mjs scripts/check-contract-deadlines.ts",
    "check:smp": "node scripts/run-ts-check.mjs scripts/check-smp-control.ts",
    "check:estimates": "node scripts/run-ts-check.mjs scripts/check-estimate-chain.ts",
    "export:pp2604-seed": "node scripts/run-ts-check.mjs scripts/export-pp2604-seed.ts",
    "preview": "vite preview",
    "build:web": "vite build",
    "serve": "node scripts/serve-dist.mjs",
    "start:fast": "npm run build:web && concurrently -n web,pg,api -c cyan,magenta,green \"npm run serve\" \"npm run pg:server\" \"npm run api\"",
    "pg:seed": "node scripts/seed-postgres.mjs",
    "pg:server": "node scripts/pg-json-server.mjs",
    "api": "node scripts/start-api.mjs",
    "start": "concurrently -n web,pg,api -c cyan,magenta,green \"npm run dev\" \"npm run pg:server\" \"npm run api\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.21.0",
    "docx": "^9.15.4",
    "lucide-react": "^0.546.0",
    "pdfmake": "^0.3.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "d3": "^7.9.2",
    "@types/d3": "^7.4.3",
    "motion": "^12.23.24",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "oxlint": "^1.89.0",
    "path-to-regexp": "^3.3.0",
    "sass": "^1.107.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "path-to-regexp": "^3.3.0"
  }
}
